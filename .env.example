# Copy this file to .env and fill in your own values.  NEVER commit .env to GitHub.

# OpenAI API key (https://platform.openai.com/api-keys).
# Leave it as-is (or empty) to run in DEMO / MOCK MODE with the rule-based engine.
OPENAI_API_KEY=sk-your-key-here

# Model to use (any chat model available on your account)
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible endpoint, e.g. a local Ollama server: http://localhost:11434/v1
OPENAI_BASE_URL=

# Optional: set to true to force demo mode even when a key is present
FORCE_MOCK_MODE=false

# Optional: request timeout in seconds
OPENAI_TIMEOUT_SECONDS=30
